# shellcheck disable=all
DISCORD_BOT_TOKEN=your-discord-token
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-6.1-terra
OPENAI_IMAGE_MODEL=gpt-6.1-terra
JOB_TEAM_CHANNEL_IDS=art:1423386525365702870,game_design:1423386553081794680,dev:1423386568919351336,others:1423386588058091552
MAX_SCRAPE_BYTES=3000000
REQUEST_TIMEOUT=30
RESPONSE_TIMEOUT=60
# Comma-separated Discord user IDs that bypass the /jobbot limits.
JOBBOT_TRUSTED_USER_IDS=
JOBBOT_MAX_REQUESTS_PER_HOUR=20
JOBBOT_MAX_REQUESTS_PER_DAY=100
# Only for older models such as gpt-4o-mini; gpt-5.4+ and gpt-6 reject temperature.
# OPENAI_TEMPERATURE=0.1
PORT=8080
LOG_LEVEL=INFO
